  };

  var GACHA_KEY_RESOLVER = {
    'n+': 'Normal+', 'Normal+': 'Normal+', 'ﾉｰﾏﾙ+': 'Normal+', '＋': 'Normal+', '＋+': 'Normal+',
    'fu': 'Fukubiki', 'Fukubiki': 'Fukubiki', '福引': 'Fukubiki', '福': 'Fukubiki', '福F': 'Fukubiki',
    'fg': 'FukubikiG', 'FukubikiG': 'FukubikiG', '福引G': 'FukubikiG', 'Ｇ': 'FukubikiG', 'ＧG': 'FukubikiG',
