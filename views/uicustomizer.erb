<%
  preferred_order = ['Normal+', 'Fukubiki', 'FukubikiG', 'Nekome', 'Matatabi', 'Normal']

  six_gachas.sort_by! { |g| preferred_order.index(g['name']) || 999 }
  true_destiny_data['alpha']&.sort_by! { |r| preferred_order.index(r['title']) || 999 }
  true_destiny_data['beta']&.sort_by! { |r| preferred_order.index(r['title']) || 999 }
%>
<style id="uicustom-wallpaper-style">
  body {
    background-image: url('./gazoo/kabegami/rakures2.3.png');
    background-size: cover;
    background-position: center center;
    background-attachment: fixed;
    background-repeat: no-repeat;
  }
</style>

<style id="uicustom-lang-mode-style">
  .ally-gem.mode-short1 .dy-data-col {
    width: auto !important;
    min-width: 34px !important;
  }
  .ally-gem.mode-short2 .dy-data-col {
    width: auto !important;
    min-width: 24px !important;
  }
  .ally-gem.mode-short1 .dy-num-col,
  .ally-gem.mode-short2 .dy-num-col {
    width: 30px !important;
  }

  .ally-gem.dupe-comma .dycell-top,
  .ally-gem.dupe-comma .dycell-btm,
  .ally-gem.dupe-comma .dy-head,
  .ally-gem.dupe-bang .dycell-top,
  .ally-gem.dupe-bang .dycell-btm,
  .ally-gem.dupe-bang .dy-head {
    padding: 2px 3px !important;
  }
  .ally-gem.mode-short2.dupe-bang .dy-data-col {
    min-width: 22px !important;
  }

  #nomatora-floating-tip {
    position: fixed;
    z-index: 9999;
    pointer-events: none;
    background-color: rgba(15, 15, 15, 0.92);
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 5px 9px;
    font-size: 0.98rem;
    font-weight: bold;
    line-height: 1.3;
    white-space: nowrap;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
    opacity: 0;
    transition: opacity 0.1s ease;
  }
  #nomatora-floating-tip.is-visible {
    opacity: 1;
  }
</style>

<script>
