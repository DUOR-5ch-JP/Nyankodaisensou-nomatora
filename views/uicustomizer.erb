<%
  preferred_order = ['Normal+', 'Fukubiki', 'FukubikiG', 'Nekome', 'Matatabi', 'Normal']

  six_gachas.sort_by! { |g| preferred_order.index(g['name']) || 999 }
  true_destiny_data['alpha']&.sort_by! { |r| preferred_order.index(r['title']) || 999 }
  true_destiny_data['beta']&.sort_by! { |r| preferred_order.index(r['title']) || 999 }
%>
<style id="uicustom-wallpaper-style">
  body {
    background-image: url('./gazoo/kabegami/rakures2.3.png');
    background-size: cover;
    background-position: center center;
    background-attachment: fixed;
    background-repeat: no-repeat;
  }
</style>

<style id="uicustom-lang-mode-style">
  .ally-gem.mode-short1 .dy-num-col,
  .ally-gem.mode-short2 .dy-num-col {
    width: 28px !important;
  }

  .ally-gem.mode-short2.dupe-bang  .dy-data-col { width: 24px !important; }
  .ally-gem.mode-short2.dupe-comma .dy-data-col { width: 52px !important; }
  .ally-gem.mode-short2.dupe-arrow .dy-data-col { width: 66px !important; }

  .ally-gem.mode-short1.dupe-bang  .dy-data-col { width: 28px !important; }
  .ally-gem.mode-short1.dupe-comma .dy-data-col { width: 58px !important; }
  .ally-gem.mode-short1.dupe-arrow .dy-data-col { width: 72px !important; }

  .ally-gem.mode-ja.dupe-bang  .dy-data-col { width: 54px !important; }
  .ally-gem.mode-ja.dupe-comma .dy-data-col { width: 78px !important; }
  .ally-gem.mode-ja.dupe-arrow .dy-data-col { width: 92px !important; }

  .ally-gem.mode-en.dupe-bang  .dy-data-col { width: 74px !important; }
  .ally-gem.mode-en.dupe-comma .dy-data-col { width: 96px !important; }
  .ally-gem.mode-en.dupe-arrow .dy-data-col { width: 108px !important; }

  .ally-gem.mode-short1 .dycell-top,
  .ally-gem.mode-short1 .dycell-btm,
  .ally-gem.mode-short1 .dy-head,
  .ally-gem.mode-short2 .dycell-top,
  .ally-gem.mode-short2 .dycell-btm,
  .ally-gem.mode-short2 .dy-head {
    padding: 2px 1px !important;
  }

  #nomatora-floating-tip {
    position: fixed;
    z-index: 9999;
    pointer-events: none;
    background-color: rgba(15, 15, 15, 0.92);
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 5px 9px;
    font-size: 0.98rem;
    font-weight: bold;
    line-height: 1.3;
    white-space: nowrap;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
    opacity: 0;
    transition: opacity 0.1s ease;
  }
  #nomatora-floating-tip.is-visible {
    opacity: 1;
  }

  .gacha-cfg-wrap {
    position: relative;
    display: inline-block;
    margin-left: 4px;
    vertical-align: middle;
  }
  .gacha-cfg-btn {
    padding: 2px 8px;
    font-size: 0.78rem;
    font-weight: bold;
    color: #333;
    background: #f0f0f0;
    border: 1px solid #999;
    border-radius: 4px;
    cursor: pointer;
  }
  .gacha-cfg-btn:hover {
    background: #e2e2e2;
  }
  .gacha-cfg-pop {
    display: none;
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    z-index: 2000;
    width: 225px;
    background: #ffffff;
    border: 1px solid #666;
    border-radius: 6px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    padding: 8px;
    box-sizing: border-box;
    text-align: left;
  }
  .gacha-cfg-pop.is-open {
    display: block;
  }
  .gacha-cfg-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    font-weight: bold;
    color: #444;
    padding-bottom: 6px;
    margin-bottom: 6px;
    border-bottom: 1px solid #ddd;
  }
  .gacha-cfg-close {
    background: none;
    border: none;
    font-size: 0.95rem;
    cursor: pointer;
    color: #666;
    padding: 0 4px;
  }
  .gacha-cfg-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .gacha-cfg-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 5px 6px;
    background: #f8f9fa;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 0.82rem;
    user-select: none;
    touch-action: none;
  }
  .gacha-cfg-item.is-dragging {
    opacity: 0.55;
    background: #e3f2fd;
    border-color: #1976d2;
  }
  .gacha-cfg-left {
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: grab;
  }
  .gacha-cfg-grip {
    color: #888;
    font-weight: bold;
    cursor: grab;
  }
  .gacha-cfg-right {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .gacha-cfg-arrows {
    display: flex;
    gap: 2px;
  }
  .gacha-cfg-arrows button {
    padding: 1px 5px;
    font-size: 0.68rem;
    background: #fff;
    border: 1px solid #bbb;
    border-radius: 3px;
    cursor: pointer;
  }
  .gacha-cfg-reset {
    margin-top: 6px;
    width: 100%;
    padding: 3px;
    font-size: 0.72rem;
    color: #555;
    background: #f5f5f5;
    border: 1px solid #ccc;
    border-radius: 4px;
    cursor: pointer;
  }
</style>

